# Server deployment only. Keep DASHBOARD_AUTH_ENABLED unset locally.
DASHBOARD_AUTH_ENABLED=1
DASHBOARD_AUTH_USERNAME=adminroot
DASHBOARD_AUTH_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
DASHBOARD_AUTH_COOKIE_SECURE=1
DASHBOARD_AUTH_TRUST_PROXY=1
DASHBOARD_AUTH_PUBLIC_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN
